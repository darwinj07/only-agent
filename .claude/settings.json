{
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(*)"
    ],
    "deny": []
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"$CLAUDE_PROJECT_DIR/context/index.md\" 2>/dev/null || echo 'No context index found.'",
            "statusMessage": "Loading session context"
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/session-audit.sh\"",
            "statusMessage": "Context health check"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/guard-bash.sh\"",
            "statusMessage": "Checking command safety"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Read|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/tree-check.sh",
            "statusMessage": "Checking tree structure"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/goal-loop-stop.sh\"",
            "statusMessage": "Checking active goal-loop gates"
          }
        ]
      }
    ]
  }
}
